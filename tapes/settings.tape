# shared settings, sourced first by every tape (not a clip itself, run the tapes from the root of the repository);
# a tape can override them with its own Set lines before sourcing tapes/prelude.tape
Set Shell bash
Set FontSize 16
Set Width 1100
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set WindowBar Colorful
Set CursorBlink false
